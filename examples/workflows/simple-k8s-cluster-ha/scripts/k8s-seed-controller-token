#!/bin/bash
set -euo pipefail
umask 077
export KUBECONFIG=/etc/kubernetes/admin.conf
test -s "$KUBECONFIG"
# Supply a known key to upload-certs, and publish it only after upload succeeds.
key=$(openssl rand -hex 32)
[[ $key =~ ^[0-9a-f]{64}$ ]]
kubeadm init phase upload-certs --upload-certs --certificate-key "$key" >/dev/null
file=$(mktemp /srv/k8s/.join-controller.XXXXXX)
trap 'rm -f "$file"' EXIT
join=$(kubeadm token create --ttl 2h --print-join-command)
test -n "$join"
printf '%s --control-plane --certificate-key %s\n' "$join" "$key" > "$file"
chown root:controller-reader "$file"
chmod 0640 "$file"
mv "$file" /srv/k8s/join-controller
