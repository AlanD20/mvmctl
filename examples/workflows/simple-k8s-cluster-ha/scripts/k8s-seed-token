#!/bin/bash
set -euo pipefail
umask 077
export KUBECONFIG=/etc/kubernetes/admin.conf
test -s "$KUBECONFIG"
file=$(mktemp /srv/k8s/.join-worker.XXXXXX)
trap 'rm -f "$file"' EXIT
kubeadm token create --ttl 2h --print-join-command > "$file"
test -s "$file"
chown root:worker-reader "$file"
chmod 0640 "$file"
mv "$file" /srv/k8s/join-worker
