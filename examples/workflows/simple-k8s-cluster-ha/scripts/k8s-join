#!/bin/bash
set -euo pipefail
umask 077
[[ $# == 2 ]] || exit 1
case $2 in
  join-controller) reader=controller-reader ;;
  join-worker) reader=worker-reader ;;
  *) exit 1 ;;
esac
if [[ -f /etc/kubernetes/kubelet.conf ]]; then exit 0; fi
join=$(timeout 60 mvm-agent remote --user "$reader" "$1" -- cat "/srv/k8s/$2")
[[ -n $join && $join == 'kubeadm join '* ]] || exit 1
# The exact controller reader policy and file ownership protect this command.
# Never echo credentials into env/exec logs.
bash -c "$join" > /var/log/k8s-join.log 2>&1
