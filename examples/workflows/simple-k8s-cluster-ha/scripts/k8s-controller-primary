#!/bin/bash
set -euo pipefail
umask 077
if [[ ! -f /etc/kubernetes/admin.conf ]]; then
  # kubeadm prints bootstrap credentials; keep its output in a root-only log.
  kubeadm init --control-plane-endpoint=10.10.0.100:6443 \
    --apiserver-advertise-address=10.10.0.10 \
    --apiserver-cert-extra-sans=10.10.0.10 \
    --pod-network-cidr=10.200.0.0/16 > /var/log/k8s-init.log 2>&1
fi
install -d -m 0700 /root/.kube
install -m 0600 /etc/kubernetes/admin.conf /root/.kube/config
k8s-seed-token
k8s-seed-controller-token
